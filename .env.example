# Build-time settings (NEXT_PUBLIC_* is inlined into the static export).
# Both are optional. Copy to .env.production to set them for `next build`.

# Cloudflare Turnstile site key (public). Unset = no widget, no token sent.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Waitlist Worker URL. Unset = https://fletaris-waitlist.uchuva-tech.workers.dev
NEXT_PUBLIC_WAITLIST_URL=
